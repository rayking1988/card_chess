{
  "name": "card-chess",
  "version": "1.0.0",
  "description": "A pixel art 2D chess online PvP game with card-based mechanics",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder --mac --x64",
    "electron:build:intel": "npm run build && electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.cardchess.app",
    "productName": "Card Chess",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "category": "public.app-category.games",
      "icon": "public/icon/icon-512.png",
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    }
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "phaser": "^3.80.1",
    "trystero": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.0",
    "fast-check": "^3.15.0"
  }
}
